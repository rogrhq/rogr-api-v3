def determine_stance_from_frames(claim_frame, evidence_frame, frame_match, claim_text, evidence_text):
    """
    Determine stance based on frame comparison and context.
    
    Returns: 'support', 'challenge', 'contextual_support', 'mixed', or 'unrelated'
    """
    from intelligence.content.shared.conditions import extract_conditions, conditions_equivalent
    
    # If frames don't match at all, check paraphrases
    if frame_match == 'mismatch':
        para_score = paraphrase_match_score(claim_text, evidence_text)
        if para_score < 0.3:
            return 'unrelated'
        # Has paraphrases, continue analysis
    
    # Extract conditions
    claim_conditions = extract_conditions(claim_text)
    evidence_conditions = extract_conditions(evidence_text)
    
    # Check if same phenomenon/entity
    same_topic = False
    if claim_frame.phenomenon and evidence_frame.phenomenon:
        if claim_frame.phenomenon == evidence_frame.phenomenon:
            same_topic = True
    elif claim_frame.entity and evidence_frame.entity:
        if claim_frame.entity.lower() == evidence_frame.entity.lower():
            same_topic = True
    
    if not same_topic:
        return 'unrelated'
    
    # Same topic - now check conditions
    same_conditions = False
    if claim_conditions and evidence_conditions:
        for cc in claim_conditions:
            for ec in evidence_conditions:
                if conditions_equivalent(cc, ec):
                    same_conditions = True
                    break
    elif not claim_conditions and not evidence_conditions:
        same_conditions = True  # Neither has conditions
    
    # Check numeric/directional agreement
    numeric_match = False
    if claim_frame.number is not None and evidence_frame.number is not None:
        from intelligence.content.shared.units import values_match
        numeric_match = values_match(claim_frame.number, evidence_frame.number)
    
    directional_match = False
    if claim_frame.direction and evidence_frame.direction:
        directional_match = (claim_frame.direction == evidence_frame.direction)
    
    # Decision tree
    if same_conditions:
        # Same topic, same conditions
        if numeric_match or directional_match:
            return 'support'
        else:
            return 'challenge'
    else:
        # Same topic, different conditions
        if numeric_match or directional_match:
            return 'contextual_support'  # Agrees but different context
        else:
            return 'mixed'  # Disagrees and different context

